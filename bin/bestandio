#!/usr/bin/env php
<?php

declare(strict_types=1);

// Bestandio command line: php bin/bestandio <migrate|status|sample-data [--force]>

if (PHP_SAPI !== 'cli') {
    exit(1);
}

require dirname(__DIR__) . '/app/bootstrap.php';

use Bestandio\Core\Config;
use Bestandio\Core\Db;
use Bestandio\Core\Migrator;

$command = $argv[1] ?? 'help';
$force = in_array('--force', array_slice($argv, 2), true);

if (!in_array($command, ['migrate', 'status', 'sample-data'], true)) {
    fwrite(STDOUT, "Usage: php bin/bestandio <command>\n\n"
        . "  migrate               apply pending migrations\n"
        . "  status                list applied and pending migrations\n"
        . "  sample-data [--force] load docs/sample-data.sql (30 example devices); refuses if the\n"
        . "                        database already has devices unless --force is given\n");
    exit($command === 'help' ? 0 : 2);
}

if (!Db::phpOk()) {
    fwrite(STDERR, 'PHP ' . PHP_VERSION . ' is too old (PHP >= ' . Db::MIN_PHP . " required).\n");
    exit(1);
}

if (!Config::exists()) {
    fwrite(STDERR, 'Configuration not found: ' . Config::path() . "\n");
    exit(1);
}

try {
    $pdo = Db::connect(Config::get('db', []));
    if (!Db::versionSupported($pdo)) {
        fwrite(STDERR, "Unsupported database version (MySQL >= 8.4 or MariaDB >= 10.11 required).\n");
        exit(1);
    }
    $migrator = new Migrator($pdo);

    if ($command === 'status') {
        $applied = $migrator->applied();
        foreach (array_keys($migrator->available()) as $version) {
            fwrite(STDOUT, sprintf("%s  %s\n", $version, in_array($version, $applied, true) ? 'applied' : 'pending'));
        }
        exit(0);
    }

    if ($command === 'sample-data') {
        // Only ever runs on this explicit command; never from /setup or automatically.
        if ($migrator->pending()) {
            fwrite(STDERR, "Run 'php bin/bestandio migrate' first.\n");
            exit(1);
        }
        $admins = (int) $pdo->query("SELECT COUNT(*) FROM users WHERE role = 'admin' AND active = 1")->fetchColumn();
        if ($admins === 0) {
            fwrite(STDERR, "No active admin found. Complete /setup first.\n");
            exit(1);
        }
        $devices = (int) $pdo->query('SELECT COUNT(*) FROM devices')->fetchColumn();
        if ($devices > 0 && !$force) {
            fwrite(STDERR, "Refused: the database already contains $devices devices. Use --force to add the sample data anyway.\n");
            exit(3);
        }
        foreach (Migrator::split((string) file_get_contents(BESTANDIO_ROOT . '/docs/sample-data.sql')) as $statement) {
            $pdo->exec($statement);
        }
        $after = (int) $pdo->query('SELECT COUNT(*) FROM devices')->fetchColumn();
        fwrite(STDOUT, 'Sample data loaded: ' . ($after - $devices) . " devices added ($after in total).\n");
        exit(0);
    }

    $done = $migrator->migrate();
    fwrite(STDOUT, $done ? 'Applied: ' . implode(', ', $done) . "\n" : "Nothing to migrate.\n");
    exit(0);
} catch (Throwable $ex) {
    fwrite(STDERR, 'Error: ' . $ex->getMessage() . "\n");
    exit(1);
}
